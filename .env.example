# Database configuration
# Para desarrollo manual (docker-compose.yml -> db-dev en puerto 5433)
# Para pruebas automáticas del agente (docker-compose.test.yml -> db-test en puerto 5434)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=endure
DB_SYNCHRONIZE=false

# Auth configuration
JWT_SECRET=change-me-in-local-env
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
