# Database configuration
# Para desarrollo manual (docker-compose.yml -> db-dev en puerto 5433)
# Para pruebas automáticas del agente (docker-compose.test.yml -> db-test en puerto 5434)
DB_USE_AZURE=false
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=endure
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
DB_SSL=false
# Mantener true si el servidor presenta un certificado validable por Node.js.
# Usar false solo si Azure/PostgreSQL exige TLS pero no se configuró CA de confianza.
DB_SSL_REJECT_UNAUTHORIZED=true

# Azure PostgreSQL (usado cuando DB_USE_AZURE=true)
# Prioridad: AZURE_DB_* -> DB_*_CLOUD -> DB_*.
AZURE_DB_HOST=<server>.postgres.database.azure.com
AZURE_DB_PORT=5432
AZURE_DB_USERNAME=<azure-user>
AZURE_DB_PASSWORD=<azure-password>
AZURE_DB_DATABASE=<azure-database>
AZURE_DB_SSL=true
AZURE_DB_SSL_REJECT_UNAUTHORIZED=true

# Alias compatible con .env existentes
DB_HOST_CLOUD=<server>.postgres.database.azure.com
DB_PORT_CLOUD=5432
DB_USERNAME_CLOUD=<azure-user>
DB_PASSWORD_CLOUD=<azure-password>
DB_DATABASE_CLOUD=<azure-database>
DB_SSL_CLOUD=true
DB_SSL_REJECT_UNAUTHORIZED_CLOUD=true

# Auth configuration
JWT_SECRET=change-me-in-local-env
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MS=900000

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# Azure Blob Storage
# Usar un connection string que incluya AccountName y AccountKey.
# Azure real:
# DefaultEndpointsProtocol=https;AccountName=tu_cuenta;AccountKey=tu_llave;EndpointSuffix=core.windows.net
# Azurite local: copiar el connection string completo desde Azure Storage Explorer o docker docs, no usar solo UseDevelopmentStorage=true.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=tu_cuenta;AccountKey=tu_llave;EndpointSuffix=core.windows.net

# Powerspike flow (trainer verification)
# Habilita el flujo de validación de entrenadores en múltiples etapas
Powerspike=true

# Azure Document Intelligence (OCR para extracción documental)
# Opcional: solo si se usa Azure real para extraer datos de certificados e IDs
# El tier gratuito F0 permite 20 páginas/mes para pruebas
AZURE_DOCUMENT_INTELLIGENCE_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<api-key>

# Habilitar pruebas de humo para almacenamiento
STORAGE_SMOKE_TEST_ENABLED=true


# Admin seed (creado automáticamente al iniciar el backend si no existe)
# Si se setean, el AdminSeeder crea un admin en BD al arrancar si no existe
ADMIN_EMAIL=admin@endure.com
ADMIN_PASSWORD=Admin123!

# Azure Document Intelligence (OCR)
# Opcional: solo si se usa Azure real para extracción documental
AZURE_DOCUMENT_INTELLIGENCE_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<api-key>

# Google OAuth Client ID (para verificar id_token en producción)
# GOOGLE_CLIENT_ID=1234567890-xxxxx.apps.googleusercontent.com

# Apple OAuth Service ID (para verificar identity_token en producción)
# APPLE_CLIENT_ID=com.endure.app

# Modo mock para desarrollo sin credenciales reales de Google/Apple
# SOCIAL_AUTH_MOCK=true

# Azure Communication Services (Email)
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://...;accesskey=...
AZURE_SENDER_EMAIL=DoNotReply@endure.com

# Estrategia de extracción documental
# Opciones: di_primary | openai_primary | openai_only | di_only
DOCUMENT_EXTRACTION_STRATEGY=di_primary

# Azure OpenAI (GPT-4o Vision) — Fallback para extracción de certificados e INE
# Requiere un deployment de gpt-4o en el recurso de Azure OpenAI
AZURE_OPENAI_ENABLED=false
AZURE_OPENAI_ENDPOINT=https://endureverification.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview
